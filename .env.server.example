# =============================================================================
# SERVER-ONLY SECRETS  —  copy to `.env.server` and fill in.
# NEVER prefix anything here with VITE_ (that would ship it to the browser).
# `.env.server` is gitignored. Do not commit real values.
# =============================================================================

# --- Database (Supabase Postgres connection string, server-side) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# --- Supabase (server) ---
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # bypasses RLS — server only, NEVER in client

# --- Stripe (server) ---
STRIPE_SECRET_KEY=                    # sk_test_... (use test until R1 passes)
STRIPE_WEBHOOK_SECRET=                # whsec_... from `stripe listen` / dashboard

# --- Email (transactional) ---
# Provider precedence: Resend → Gmail/SMTP → console (no-op).
RESEND_API_KEY=                       # recommended for production (https://resend.com)
EMAIL_FROM=Meyaar Jewellers <orders@meyaarjewellers.com>
GMAIL_USER=meyaarjewellers@gmail.com
GMAIL_APP_PASSWORD=                   # dev fallback

# --- App ---
APP_URL=https://meyaarjewellers.com   # used in email links / redirects

# --- Observability (optional) ---
SENTRY_DSN=                           # enable error monitoring when set

# --- Admin dashboard access ---
# Comma-separated emails allowed into /admin (must be Supabase Auth users).
ADMIN_EMAILS=you@example.com

# --- Commerce config (server-authoritative; integer minor units / cents) ---
SHIPPING_FLAT_RATE_CENTS=900          # flat shipping below the free threshold
SHIPPING_FREE_THRESHOLD_CENTS=10000   # subtotal at/above which shipping is free
DEFAULT_CURRENCY=usd

# --- Runtime ---
PORT=3000
NODE_ENV=development
# Comma-separated allowed origins for CORS in production
CORS_ALLOWED_ORIGINS=https://meyaarjewellers.com
