{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "config/**/*.ts",
    "db/**/*.ts",
    "services/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "routes.ts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "migrations", "scripts", "vite.ts", "index.ts"]
}
